# 本番用の入口。画面のファイルを配り、/api/ で始まるものだけを backend へ中継する。
#
# SITE_ADDRESS に、ドメイン名(例: xxx.duckdns.org)を指定すると、
# Caddy が証明書を自動で取得して、HTTPS で配信する(80番は、HTTPSへ転送される)。
# 未指定のときは、HTTP の80番だけで動く。
{$inquirymngmt::80} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# API は backend(FastAPI)へ中継する
	handle /api/* {
		reverse_proxy backend:8000
	}

	# それ以外は、ビルド済みの画面を返す(存在しないパスは index.html へ)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
