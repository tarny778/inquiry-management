# Docker開発環境用の設定ファイルの雛形
# このファイルを .env.docker という名前でコピーし、パスワードを自分で決めて書き換える
# (.env.docker は Git 管理外)

APP_ENV=development

# ホスト側(自分のPC)から、コンテナ内のDBへ接続するためのURL
# パスワードは、上の DOCKER_POSTGRES_PASSWORD と同じ値にする
# ポートは compose.yaml で公開している 5433
DATABASE_URL=postgresql://inquiry_app:ここにパスワードを書く@localhost:5433/inquiry_management_dev?sslmode=disable

CORS_ORIGINS=http://localhost:5173
# PostgreSQL コンテナのパスワード(任意の値)
DOCKER_POSTGRES_PASSWORD=ここにパスワードを書く


