# ---- 1. 画面をビルドする ----
FROM node:24-slim AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# APIのアドレスを空にする(画面と同じ入口に、相対パスでアクセスする)
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# ---- 2. ビルド済みのファイルを、Caddyで配る ----
FROM caddy:2-alpine

COPY --from=build /app/dist /srv

# Caddyfile は、compose から /etc/caddy/Caddyfile にマウントする
EXPOSE 80